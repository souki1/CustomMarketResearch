{
  "name": "CustomMarketResearch",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && . .venv/bin/activate && python -B -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "description": "FastAPI backend (InteligentResearch API) on http://localhost:8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173",
      "description": "Vite/React frontend dev server on http://localhost:5173"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 5173 },
    { "name": "backend", "port": 8000 }
  ]
}
