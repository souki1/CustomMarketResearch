# PostgreSQL (use same credentials as in pgAdmin4; create DB "inteligent_research" in pgAdmin if needed)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/inteligent_research

# JWT and session (use a long random string of at least 32 characters in production)
SECRET_KEY=your-secret-key-change-in-production
ENVIRONMENT=development

# JWT algorithm (usually HS256)
ALGORITHM=HS256

# Access token expiry in minutes (480 = 8 hours). Refresh tokens last REFRESH_TOKEN_EXPIRE_DAYS.
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth lockout / rate limits
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120

# Set true only when the API sits behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Comma-separated hosts for TrustedHostMiddleware (empty = disabled, recommended for local)
TRUSTED_HOSTS=

# Google OAuth: create at https://console.cloud.google.com/apis/credentials
# Add redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL (for OAuth redirect after login)
FRONTEND_URL=http://localhost:5173 || http://localhost:5174/

# MongoDB — required for datasheet, research URLs, portfolio, and AI history
# Example: mongodb://localhost:27017
MONGO_URL=
MONGO_DB_NAME=inteligent_research

# Serper.dev Google Search API (https://serper.dev/)
SERPER_API_KEY=

# Groq (https://console.groq.com/) — llama-3.3-70b-versatile was shut down 2026-08-16
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Firecrawl web scraping (https://firecrawl.dev/) – 401 = invalid key
FIRECRAWL_API_KEY=
# Overlapping Firecrawl scrapes (1–8). Lower to 1 if you see 429 Too Many Requests.
FIRECRAWL_MAX_CONCURRENCY=2
# Sheet rows to Google-search in parallel (1–10). Scrapes use FIRECRAWL_MAX_CONCURRENCY.
RESEARCH_ROW_CONCURRENCY=6

# Optional SMTP for password-change codes. Leave empty to print codes in the backend log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Development helper: include OTP in API response (MUST be false in production)
DEV_RETURN_OTP=false
